[Unit]
Description=Higgs QQ agent stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/apps/higgs/current/deploy/higgs
EnvironmentFile=/srv/secrets/higgs/stack.env
ExecStart=/usr/bin/docker compose --env-file /srv/secrets/higgs/stack.env up -d --wait
ExecReload=/usr/bin/docker compose --env-file /srv/secrets/higgs/stack.env up -d --wait
ExecStop=/usr/bin/docker compose --env-file /srv/secrets/higgs/stack.env stop
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
