# Copy to the private HIGGS_CONFIG_DIR as official-qq.env and chmod 0600.
# Never commit or paste real values into chat or logs.
HIGGS_OFFICIAL_QQ_SIDECAR_ENABLED=false
HIGGS_OFFICIAL_QQ_CAPTURE_ONLY=true
HIGGS_OFFICIAL_QQ_PROACTIVE_ENABLED=false
HIGGS_OFFICIAL_QQ_ORDINARY_PRIVATE_ENABLED=false
HIGGS_OFFICIAL_QQ_GROUP_ENABLED=false
HIGGS_OFFICIAL_QQ_SESSION_FILE=/var/lib/higgs-official/session.json
HIGGS_OFFICIAL_QQ_OWNER_OPENID=replace-with-private-owner-openid
HIGGS_OFFICIAL_QQ_ALLOWED_PRIVATE_OPENIDS=
HIGGS_OFFICIAL_QQ_ALLOWED_GROUP_OPENIDS=
HIGGS_OFFICIAL_QQ_PRIVATE_ALLOWLIST_VERSION=
HIGGS_OFFICIAL_QQ_PRIVATE_ALLOWLIST_FINGERPRINT=
HIGGS_OFFICIAL_QQ_GROUP_ALLOWLIST_VERSION=
HIGGS_OFFICIAL_QQ_GROUP_ALLOWLIST_FINGERPRINT=
HIGGS_OFFICIAL_QQ_PRIVATE_RATE_PER_MINUTE=30
HIGGS_OFFICIAL_QQ_GROUP_RATE_PER_MINUTE=60
HIGGS_OFFICIAL_QQ_PRIVATE_CIRCUIT_FAILURE_LIMIT=5
HIGGS_OFFICIAL_QQ_GROUP_CIRCUIT_FAILURE_LIMIT=5
HIGGS_OFFICIAL_QQ_PRIVATE_CIRCUIT_COOLDOWN_SECONDS=300
HIGGS_OFFICIAL_QQ_GROUP_CIRCUIT_COOLDOWN_SECONDS=300
HIGGS_OFFICIAL_QQ_PRIVATE_CAPTURE_FILE=/var/lib/higgs-official/private-users-capture.json
HIGGS_OFFICIAL_QQ_PRIVATE_ALLOWLIST_FILE=/var/lib/higgs-official/allowed-private-openids.json
HIGGS_OFFICIAL_QQ_GROUP_CAPTURE_FILE=/var/lib/higgs-official/group-capture.json
HIGGS_OFFICIAL_QQ_GROUP_ALLOWLIST_FILE=/var/lib/higgs-official/allowed-group-openids.json
QQBOT_APP_ID=replace-with-private-app-id
QQBOT_APP_SECRET=replace-with-private-app-secret
