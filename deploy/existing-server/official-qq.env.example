# Copy to the private HIGGS_CONFIG_DIR as official-qq.env and chmod 0600.
# Never commit or paste real values into chat or logs.
HIGGS_OFFICIAL_QQ_SIDECAR_ENABLED=false
HIGGS_OFFICIAL_QQ_CAPTURE_ONLY=true
HIGGS_OFFICIAL_QQ_SESSION_FILE=/var/lib/higgs-official/session.json
HIGGS_OFFICIAL_QQ_OWNER_OPENID=replace-with-private-owner-openid
HIGGS_OFFICIAL_QQ_ALLOWED_GROUP_OPENIDS=
QQBOT_APP_ID=replace-with-private-app-id
QQBOT_APP_SECRET=replace-with-private-app-secret
