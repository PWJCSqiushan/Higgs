# Copy to /srv/secrets/higgs/stack.env and keep mode 0600.
# Never commit the real file.

# Must be a full immutable digest after pulling v4.18.13, for example:
# mlikiowa/napcat-docker@sha256:<64 hex characters>
NAPCAT_IMAGE=

# Use the Git commit in the local image tag.
HIGGS_IMAGE=higgs-agent:replace-with-git-commit

# These values belong only in the private server copy.
NAPCAT_ACCOUNT=
NAPCAT_WEBUI_TOKEN=
NAPCAT_ONEBOT_TOKEN=

HIGGS_DATA_ROOT=/srv/data/higgs
HIGGS_CONFIG_DIR=/srv/secrets/higgs
HIGGS_PERSONA_FILE=/srv/secrets/higgs/persona.md
NAPCAT_WEBUI_PORT=16099
NAPCAT_UID=1000
NAPCAT_GID=1000

PYTHON_IMAGE=python:3.12.11-slim-bookworm
UV_VERSION=0.11.19
