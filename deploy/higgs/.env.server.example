HIGGS_IMAGE=ghcr.io/pwjcsqiushan/higgs-agent:REPLACE_COMMIT@sha256:REPLACE_WITH_VERIFIED_DIGEST
PYTHON_IMAGE=python:3.12.11-slim-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.19@sha256:REPLACE_WITH_VERIFIED_DIGEST
