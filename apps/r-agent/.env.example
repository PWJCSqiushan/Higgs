# Never put a QQ password, phone number, QR session, cookie, or real token here.
# NapCat owns QQ login. This service only receives OneBot events.

R_AGENT_SHADOW_MODE=true
R_AGENT_INGEST_ENABLED=true
R_AGENT_DATA_DIR=./data

R_AGENT_ONEBOT_WS_URL=ws://127.0.0.1:3001
R_AGENT_ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-token

# This is the human owner's QQ, NOT the bot account.
# Leave empty until the owner identity is deliberately confirmed.
R_AGENT_OWNER_QQ=

# Exact non-owner QQ accounts allowed to enter the local pipeline.
# Comma-separated; empty means owner-only private chat. Wildcards are rejected.
R_AGENT_ALLOWED_PRIVATE_QQS=

# Empty means no groups are observed. Add only explicitly approved test groups.
R_AGENT_ALLOWED_GROUPS=

# Raw normalized journal retention. Phase 1 default is seven days.
R_AGENT_JOURNAL_RETENTION_DAYS=7
