# Phase 2 replies: off (default), draft (model + local review), or live.
R_AGENT_REPLY_MODE=off
# `/higgs disable` pauses ordinary replies while owner commands remain online.
R_AGENT_RUNTIME_ENABLED=true

# Fail closed if NapCat restored the wrong QQ account. This is the bot account,
# not R_AGENT_OWNER_QQ.
R_AGENT_EXPECTED_BOT_QQ=
# Optional offline/recovery alert token. Keep the real value in private secrets only.
R_AGENT_PUSHPLUS_TOKEN=

# Non-owner private reply targets. Every account must also appear in
# R_AGENT_ALLOWED_PRIVATE_QQS. The configured owner is included automatically.
R_AGENT_REPLY_ALLOWED_PRIVATE_QQS=

# Keep empty for the first owner-private rollout. Groups must also be in Phase 1 ingress roots.
R_AGENT_REPLY_ALLOWED_GROUPS=
R_AGENT_REPLY_GROUP_REQUIRE_MENTION=true

# Subset of reply groups where @ can be replaced by a configured exact keyword or a reply
# to a message previously sent by this bot account.
R_AGENT_REPLY_NATURAL_TRIGGER_GROUPS=
# Comma-separated. Deliberately excludes the ambiguous pronoun "你".
R_AGENT_REPLY_NATURAL_TRIGGER_TERMS=higgs
# Seven-day low-frequency baseline. Owner has a separate finite minute budget.
R_AGENT_REPLY_MAX_PER_MINUTE=2
R_AGENT_REPLY_GLOBAL_MAX_PER_MINUTE=6
R_AGENT_REPLY_NON_OWNER_HOURLY_LIMIT=20
R_AGENT_REPLY_NON_OWNER_DAILY_LIMIT=80
R_AGENT_REPLY_OWNER_CONVERSATION_PER_MINUTE=4
R_AGENT_REPLY_OWNER_HOURLY_LIMIT=40
R_AGENT_REPLY_OWNER_DAILY_LIMIT=120
R_AGENT_REPLY_GLOBAL_HOURLY_LIMIT=60
R_AGENT_REPLY_GLOBAL_DAILY_LIMIT=200
# Optional content-free operational metadata for the local risk ledger.
R_AGENT_QQ_CLIENT_VERSION=
R_AGENT_NAPCAT_VERSION=
R_AGENT_EGRESS_ASN=
# Merge rapid fragments from the same sender in one group into one logical turn.
R_AGENT_GROUP_DEBOUNCE_SECONDS=2.5
# Private chats use a slightly longer quiet window to avoid one reply per fragment.
R_AGENT_PRIVATE_DEBOUNCE_SECONDS=4.0

# Official QQ Bot is a separate identity and stays disabled until a sandbox app exists.
# The production path uses the local UDS sidecar. AppID and ClientSecret belong only in
# the sidecar's separate 0600 official-qq.env and must stay absent from this Agent env.
R_AGENT_OFFICIAL_QQ_ENABLED=false
R_AGENT_OFFICIAL_QQ_REPLY_ENABLED=false
# Separate owner-C2C proactive gate; keep false through the 72-hour observation.
R_AGENT_OFFICIAL_QQ_PROACTIVE_ENABLED=false
R_AGENT_OFFICIAL_QQ_TRANSPORT=sidecar
R_AGENT_OFFICIAL_QQ_SIDECAR_SOCKET=/run/higgs-official/sidecar.sock
R_AGENT_OFFICIAL_QQ_SANDBOX=true
R_AGENT_OFFICIAL_QQ_APP_ID=
R_AGENT_OFFICIAL_QQ_CLIENT_SECRET=
R_AGENT_OFFICIAL_QQ_OWNER_OPENID=
# The MVP accepts only GROUP_AT_MESSAGE_CREATE from these explicit sandbox groups.
R_AGENT_OFFICIAL_QQ_ALLOWED_GROUP_OPENIDS=

# Outbound safety is checked after Markdown cleanup and before any QQ send action.
R_AGENT_SAFETY_ENABLED=true
# Optional ignored local file, one extra blocked term per line:
# R_AGENT_SAFETY_TERMS_FILE=./sensitive_terms.local.txt

# Non-replied group self-facts become candidates. Conservative automatic review is
# enabled with strict defaults. It can only activate repeated, low-risk
# first-person preferences from the same principal; every other memory stays manual.
R_AGENT_PASSIVE_LEARNING_ENABLED=false
R_AGENT_MEMORY_AUTO_REVIEW_ENABLED=true
R_AGENT_MEMORY_AUTO_REVIEW_CONFIDENCE=0.90
R_AGENT_MEMORY_AUTO_REVIEW_EVIDENCE=2
# Model assistance can only write the separate shadow review table. It never activates memory.
R_AGENT_MEMORY_MODEL_CANDIDATES=off
# Self-memory is a separate, explicit rollout. Deploy code with both values off;
# schema v4 migration and shadow/autonomous processing require separate approval.
R_AGENT_SELF_MEMORY_SCHEMA_V4_ENABLED=false
R_AGENT_SELF_MEMORY_MODE=off

# Local hashing keeps QQ text on this server; use remote only after explicit privacy approval.
R_AGENT_EMBEDDING_BACKEND=local
# Remote embedding is optional. The model API key is reused unless a separate key is set.
R_AGENT_EMBEDDING_ENABLED=true
R_AGENT_EMBEDDING_MODEL=embedding-3
R_AGENT_EMBEDDING_DIMENSIONS=256

# Consistent local SQLite backups. Prefer another physical disk for BACKUP_DIR.
# R_AGENT_BACKUP_DIR=E:/Higgs-Backups
R_AGENT_BACKUP_INTERVAL_MINUTES=360
R_AGENT_BACKUP_RETENTION=20

# Governed daily planning. Start with shadow: drafts are generated and validated,
# but confirmation never activates a plan or creates real reminders.
R_AGENT_DAILY_PLAN_MODE=off
R_AGENT_DAILY_PLAN_DRAFTS_PER_DAY=10
R_AGENT_DAILY_PLAN_MAP_OPTIMIZATIONS_PER_DAY=3
# Optional Amap Web Service key. Keep it only in the private env/secrets file.
# R_AGENT_AMAP_WEB_KEY=
# R_AGENT_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# R_AGENT_EMBEDDING_API_KEY=

# Bounded multi-turn context. Draft history and live history never mix.
R_AGENT_HISTORY_TURNS=8
R_AGENT_MEMORY_CONTEXT_ITEMS=8

# Recommended: copy persona.example.md to the ignored persona.local.md and edit locally.
R_AGENT_PERSONA_FILE=./persona.local.md
# Persona V2 is owner official-C2C only and remains off until its own gray release.
R_AGENT_PERSONA_V2_ENABLED=false
# R_AGENT_PERSONA_DIR=./persona-v2
# Fallback when no persona file is configured:
# R_AGENT_PERSONA=你是一个稳重、诚实、简洁的中文助手。

# Live additionally requires both settings below and a real model API key.
R_AGENT_PHASE2_ENABLE_LIVE=false
# R_AGENT_SHADOW_MODE=false

# OpenAI-compatible model settings. The safe first rollout uses Zhipu GLM-5.2.
# Keep the API key only in local .env; never commit or paste it into chat/logs.
# OpenAI:   https://api.openai.com/v1            + an enabled model
# GLM:      https://open.bigmodel.cn/api/paas/v4 + glm-5.2
# DeepSeek: https://api.deepseek.com/v1           + deepseek-chat
R_AGENT_MODEL_PROVIDER=zhipu
R_AGENT_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
R_AGENT_MODEL_NAME=glm-5.2
R_AGENT_MODEL_THINKING=disabled
R_AGENT_MODEL_API_KEY=
