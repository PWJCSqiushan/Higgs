ARG PYTHON_IMAGE=python:3.12.11-slim-bookworm

FROM ${PYTHON_IMAGE}

ARG UV_VERSION=0.11.19
ARG PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_DEFAULT_INDEX=${PYPI_INDEX_URL} \
    PATH=/app/.venv/bin:$PATH

# This host cannot reliably reach GHCR and has unstable transfers from the
# default PyPI file host. Use Tencent Cloud's HTTPS PyPI mirror instead.
RUN python -m pip install --no-cache-dir \
    --index-url "${PYPI_INDEX_URL}" \
    "uv==${UV_VERSION}"

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
# The existing OpenCloudOS host can reach the Tencent index reliably, while
# direct wheel URLs retained in uv.lock may stall.  Export the exact locked
# versions without their source URLs, install them through UV_DEFAULT_INDEX,
# then require both sync steps to run fully offline.
RUN uv export --frozen --no-dev --no-emit-project --no-hashes \
        > /tmp/requirements.locked.txt \
    && uv venv /tmp/build-system \
    && uv pip install \
        --python /tmp/build-system/bin/python \
        "hatchling==1.27.0" \
    && uv venv .venv \
    && uv pip install \
        --python .venv/bin/python \
        --requirements /tmp/requirements.locked.txt \
    && uv sync --frozen --no-dev --no-install-project --offline
COPY src ./src
RUN uv sync --frozen --no-dev --offline

RUN groupadd --gid 10001 higgs \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin higgs \
    && mkdir -p /app/data \
    && chown -R higgs:higgs /app/data

USER higgs
CMD ["python", "-m", "r_agent.phase2_cli", "listen"]
