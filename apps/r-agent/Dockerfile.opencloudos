ARG PYTHON_IMAGE=python:3.12.11-slim-bookworm

FROM ${PYTHON_IMAGE}

ARG UV_VERSION=0.11.19

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH=/app/.venv/bin:$PATH

# The existing Tencent Cloud host cannot reliably reach GHCR, so install the
# pinned uv release from PyPI instead of copying it from ghcr.io.
RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}"

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev

RUN groupadd --gid 10001 higgs \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin higgs \
    && mkdir -p /app/data \
    && chown -R higgs:higgs /app/data

USER higgs
CMD ["python", "-m", "r_agent.phase2_cli", "listen"]
