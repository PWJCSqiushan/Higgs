ARG PYTHON_IMAGE=python:3.12.11-slim-bookworm

FROM ${PYTHON_IMAGE}

ARG UV_VERSION=0.11.19
ARG PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_DEFAULT_INDEX=${PYPI_INDEX_URL} \
    PATH=/app/.venv/bin:$PATH

# This host cannot reliably reach GHCR and has unstable transfers from the
# default PyPI file host. Use Tencent Cloud's HTTPS PyPI mirror instead.
RUN python -m pip install --no-cache-dir \
    --index-url "${PYPI_INDEX_URL}" \
    "uv==${UV_VERSION}"

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev

RUN groupadd --gid 10001 higgs \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin higgs \
    && mkdir -p /app/data \
    && chown -R higgs:higgs /app/data

USER higgs
CMD ["python", "-m", "r_agent.phase2_cli", "listen"]
